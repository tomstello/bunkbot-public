OPENROUTER_API_KEY=

# Model overrides
EXTRACTION_MODEL=openrouter/openai/gpt-5-mini
CLAIM_CODING_MODEL=openrouter/openai/gpt-5-mini
ELIGIBILITY_MODEL=openrouter/openai/gpt-5-mini
FACT_CHECK_MODEL=openrouter/perplexity/sonar-pro

# Runtime tuning
LITELLM_REQUEST_TIMEOUT=120
LITELLM_NUM_RETRIES=3
EXTRACTION_CONCURRENT_REQUESTS=24
EXTRACTION_BATCH_SIZE=48
CLAIMS_PER_REQUEST=8
CLAIM_CODING_CONCURRENT_REQUESTS=12
CLAIM_CODING_API_BATCH_SIZE=24
FACT_CHECK_CONCURRENT_REQUESTS=12
FACT_CHECK_BATCH_SIZE=24
FACT_CHECK_CONTEXT_CHARS=750
