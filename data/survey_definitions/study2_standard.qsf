":1,"Flow":[{"Type":"EmbeddedData","FlowID":"FL_28","EmbeddedData":[{"Description":"condition","Type":"Custom","Field":"condition","VariableType":"String","DataVisibility":[],"AnalyzeText":false,"Value":"treatment_mid_debunk"}]},{"Type":"EmbeddedData","FlowID":"FL_29","EmbeddedData":[{"Description":"condition","Type":"Custom","Field":"condition","VariableType":"String","DataVisibility":[],"AnalyzeText":false,"Value":"treatment_mid_debunk"}]},{"Type":"EmbeddedData","FlowID":"FL_36","EmbeddedData":[{"Description":"condition","Type":"Custom","Field":"condition","VariableType":"String","DataVisibility":[],"AnalyzeText":false,"Value":"treatment_mid_bunk"}]},{"Type":"EmbeddedData","FlowID":"FL_37","EmbeddedData":[{"Description":"condition","Type":"Custom","Field":"condition","VariableType":"String","DataVisibility":[],"AnalyzeText":false,"Value":"treatment_mid_bunk"}]}]},{"Type":"EmbeddedData","FlowID":"FL_86","EmbeddedData":[{"Description":"original_condition","Type":"Custom","Field":"original_condition","VariableType":"String","DataVisibility":[],"AnalyzeText":false,"Value":"${e:\/\/Field\/condition}"}]},{"Type":"Group","FlowID":"FL_173","Description":"Full Conspiracy Solicitation Branching","Flow":[{"Type":"Group","FlowID":"FL_79","Description":"Debunk","Flow":[{"Type":"Branch","FlowID":"FL_43","Description":"New Branch","BranchLogic":{"0":{"0":{"LogicType":"EmbeddedField","LeftOperand":"condition","Operator":"EqualTo","RightOperand":"treatment_debunk","_HiddenExpression":false,"Type":"Expression","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"LeftOpDesc\">condition<\/span> <span class=\"OpDesc\">Is Equal to<\/span> <span class=\"RightOpDesc\"> treatment_debunk <\/span>"},"Type":"If"},"Type":"BooleanExpression"},"Flow":[{"Type":"Standard","ID":"BL_73DUb8NLjPUwMui","FlowID":"FL_40","Autofill":[]},{"Type":"WebService","FlowID":"FL_46","URL":"https:\/\/api.openai.com\/v1\/chat\/completions","Method":"POST","RequestParams":[],"EditBodyParams":[{"key":"model","value":"gpt-4o"},{"key":"messages","value":"[\n    {\n      \"role\": \"system\",\n      \"content\": \"Summarize the following passage, which probably describes a conspiracy belief, in a single sentence. Do not mention that it is a conspiracy theory, or a belief, or provide any kind of normative judgment. Merely accurately describe the content of the conspiracy theory in a single sentence, framing it in a manner that suggests the conspiracy is TRUE. So, even if the writer is arguing that the earth is not flat, you would say 'the earth is flat'). Frame it as a true assertion (regardless of whether evidence actually supports the belief). If the statement is already short, no need to change it very much. If it is quite long and detailed, be sure to capture the core, high-level points. If the respondent equivocates or couches their language in uncertainty, be sure not to include this equivocation in your summary. Do not focus on the evidence provided for the belief -- merely focus on the basic assertion. That is, use the evidence and justifications they might provide only for context. For your information, the passage was written by a participant in an online academic survey in response to the following two questions: < Q1: ${q:\/\/QID67\/QuestionText} > < ${q:\/\/QID68\/QuestionText} > Again, your role is to summarize the overarching belief captured by this response. Your summary will be shown to the participant, who will be asked to rate their agreement with the statement; their belief in the summary will be used as a psychometrics-style item in a scientific experiment.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Question 1 Response: ${q:\/\/QID67\/ChoiceTextEntryValue}, Question 2 Response: ${q:\/\/QID68\/ChoiceTextEntryValue}\"\n    }\n  ]","parameterType":"JSON"},{"key":"max_tokens","value":"150","parameterType":"Number"}],"Body":{"model":"gpt-4o","messages":[{"role":"system","content":"Summarize the following passage, which probably describes a conspiracy belief, in a single sentence. Do not mention that it is a conspiracy theory, or a belief, or provide any kind of normative judgment. Merely accurately describe the content of the conspiracy theory in a single sentence, framing it in a manner that suggests the conspiracy is TRUE. So, even if the writer is arguing that the earth is not flat, you would say 'the earth is flat'). Frame it as a true assertion (regardless of whether evidence actually supports the belief). If the statement is already short, no need to change it very much. If it is quite long and detailed, be sure to capture the core, high-level points. If the respondent equivocates or couches their language in uncertainty, be sure not to include this equivocation in your summary. Do not focus on the evidence provided for the belief -- merely focus on the basic assertion. That is, use the evidence and justifications they might provide only for context. For your information, the passage was written by a participant in an online academic survey in response to the following two questions: < Q1: ${q:\/\/QID67\/QuestionText} > < ${q:\/\/QID68\/QuestionText} > Again, your role is to summarize the overarching belief captured by this response. Your summary will be shown to the participant, who will be asked to rate their agreement with the statement; their belief in the summary will be used as a psychometrics-style item in a scientific experiment."},{"role":"user","content":"Question 1 Response: ${q:\/\/QID67\/ChoiceTextEntryValue}, Question 2 Response: ${q:\/\/QID68\/ChoiceTextEntryValue}"}],"max_tokens":150},"ContentType":"application\/json","Headers":[{"key":"Authorization","value":"Bearer REDACTED_OPENAI_KEY_ROTATE_ME"}],"ResponseMap":[{"key":"choices.0.message.content","value":"conRestatement"}],"FireAndForget":false,"SchemaVersion":0,"StringifyValues":true},{"Type":"WebService","FlowID":"FL_47","URL":"https:\/\/api.openai.com\/v1\/chat\/completions","Method":"POST","RequestParams":[],"EditBodyParams":[{"key":"model","value":"gpt-4o"},{"key":"messages","value":"[\n    {\n      \"role\": \"system\",\n      \"content\": \"Describe the conspiracy being discussed in a sentence or two. Do not provide any kind of normative judgment. Merely accurately describe the conspiracy theory at hand (framing it in a way so that another reader would understand what the conspiracy theory claims and is about. Do not focus unduly the evidence provided for the belief -- mostly focus on the basic assertion. Try to ignore whether the person who authored the text you'll be reading supports or opposes the conspiracy. Your job is just to capture the conspiracy claim. So, if they oppose the truth of the conspiracy, that is fine, but still return a description of the conspiracy that they're claiming is not true. For your context, the text you will be reading was written by a participant in an online academic survey in response to the following two questions: < Q1: ${q:\/\/QID67\/QuestionText} > < ${q:\/\/QID68\/QuestionText} >\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Question 1 Response: ${q:\/\/QID67\/ChoiceTextEntryValue}, Question 2 Response: ${q:\/\/QID68\/ChoiceTextEntryValue}\"\n    }\n  ]","parameterType":"JSON"},{"key":"max_tokens","value":"150","parameterType":"Number"}],"Body":{"model":"gpt-4o","messages":[{"role":"system","content":"Describe the conspiracy being discussed in a sentence or two. Do not provide any kind of normative judgment. Merely accurately describe the conspiracy theory at hand (framing it in a way so that another reader would understand what the conspiracy theory claims and is about. Do not focus unduly the evidence provided for the belief -- mostly focus on the basic assertion. Try to ignore whether the person who authored the text you'll be reading supports or opposes the conspiracy. Your job is just to capture the conspiracy claim. So, if they oppose the truth of the conspiracy, that is fine, but still return a description of the conspiracy that they're claiming is not true. For your context, the text you will be reading was written by a participant in an online academic survey in response to the following two questions: < Q1: ${q:\/\/QID67\/QuestionText} > < ${q:\/\/QID68\/QuestionText} >"},{"role":"user","content":"Question 1 Response: ${q:\/\/QID67\/ChoiceTextEntryValue}, Question 2 Response: ${q:\/\/QID68\/ChoiceTextEntryValue}"}],"max_tokens":150},"ContentType":"application\/json","Headers":[{"key":"Authorization","value":"Bearer REDACTED_OPENAI_KEY_ROTATE_ME"}],"ResponseMap":[{"key":"choices.0.message.content","value":"conSummary"}],"FireAndForget":false,"SchemaVersion":0,"StringifyValues":true},{"Type":"WebService","FlowID":"FL_70","URL":"https:\/\/api.openai.com\/v1\/chat\/completions","Method":"POST","RequestParams":[],"EditBodyParams":[{"key":"model","value":"gpt-4o"},{"key":"messages","value":"[\n    {\n      \"role\": \"system\",\n      \"content\": \"Determine if the following written response to a question posed in an online survey collectively contain or reflect AFFIRMATIVE belief in a conspiracy theory (or something quite like a conspiracy theory). For your context, the text you will be reading was written by a participant in an online academic survey in response to the following two questions: < Q1: ${q:\/\/QID67\/QuestionText} > < Q2: ${q:\/\/QID68\/QuestionText} > The participant's answers to these questions are piped in as the first user response of this chat. Please determine if the participant's answers to these questions contain or reflect affirmative belief in a conspiracy theory (or something quite like a conspiracy theory). If they contain or reflect affirmative belief in a conspiracy theory (or something quite like a conspiracy theory), respond only PASS; else, respond only either FAIL or AMBIGUOUS.\"\n    },\n    {\n      \"role\": \"user\",\n        \"content\": \"Question 1 Response: ${q:\/\/QID67\/ChoiceTextEntryValue}, Question 2 Response: ${q:\/\/QID68\/ChoiceTextEntryValue}\"    }\n  ]","parameterType":"JSON"},{"key":"max_tokens","value":"5","parameterType":"Number"}],"Body":{"model":"gpt-4o","messages":[{"role":"system","content":"Determine if the following written response to a question posed in an online survey collectively contain or reflect AFFIRMATIVE belief in a conspiracy theory (or something quite like a conspiracy theory). For your context, the text you will be reading was written by a participant in an online academic survey in response to the following two questions: < Q1: ${q:\/\/QID67\/QuestionText} > < Q2: ${q:\/\/QID68\/QuestionText} > The participant's answers to these questions are piped in as the first user response of this chat. Please determine if the participant's answers to these questions contain or reflect affirmative belief in a conspiracy theory (or something quite like a conspiracy theory). If they contain or reflect affirmative belief in a conspiracy theory (or something quite like a conspiracy theory), respond only PASS; else, respond only either FAIL or AMBIGUOUS."},{"role":"user","content":"Question 1 Response: ${q:\/\/QID67\/ChoiceTextEntryValue}, Question 2 Response: ${q:\/\/QID68\/ChoiceTextEntryValue}"}],"max_tokens":5},"ContentType":"application\/json","Headers":[{"key":"Authorization","value":"Bearer REDACTED_OPENAI_KEY_ROTATE_ME"}],"ResponseMap":[{"key":"choices.0.message.content","value":"isConspiracy"}],"FireAndForget":false,"SchemaVersion":0,"StringifyValues":true},{"Type":"Branch","FlowID":"FL_107","Description":"New Branch","BranchLogic":{"0":{"0":{"LogicType":"EmbeddedField","LeftOperand":"isConspiracy","Operator":"EqualTo","RightOperand":"FAIL","_HiddenExpression":false,"Type":"Expression","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"LeftOpDesc\">isConspiracy<\/span> <span class=\"OpDesc\">Is Equal to<\/span> <span class=\"RightOpDesc\"> FAIL <\/span>"},"Type":"If"},"Type":"BooleanExpression"},"Flow":[{"Type":"EmbeddedData","FlowID":"FL_108","EmbeddedData":[{"Description":"condition","Type":"Custom","Field":"condition","VariableType":"String","DataVisibility":[],"AnalyzeText":false,"Value":"treatment_bunk"},{"Description":"reroute","Type":"Custom","Field":"reroute","VariableType":"String","DataVisibility":[],"AnalyzeText":false,"Value":"true"},{"Description":"original_theory","Type":"Custom","Field":"original_theory","VariableType":"String","DataVisibility":[],"AnalyzeText":false,"Value":"${e:\/\/Field\/conRestatement}"}]},{"Type":"Block","ID":"BL_6x84aTsJIn8gKpg","FlowID":"FL_124","Autofill":[]}]}]}]},{"Type":"Group","FlowID":"FL_78","Description":"Bunk","Flow":[{"Type":"Branch","FlowID":"FL_41","Description":"New Branch","BranchLogic":{"0":{"0":{"LogicType":"EmbeddedField","LeftOperand":"condition","Operator":"EqualTo","RightOperand":"treatment_bunk","_HiddenExpression":false,"Type":"Expression","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"LeftOpDesc\">condition<\/span> <span class=\"OpDesc\">Is Equal to<\/span> <span class=\"RightOpDesc\"> treatment_bunk <\/span>"},"Type":"If"},"Type":"BooleanExpression"},"Flow":[{"Type":"Standard","ID":"BL_3rqtKoYtHr034j4","FlowID":"FL_31","Autofill":[]},{"Type":"WebService","FlowID":"FL_33","URL":"https:\/\/api.openai.com\/v1\/chat\/completions","Method":"POST","RequestParams":[],"EditBodyParams":[{"key":"model","value":"gpt-4o"},{"key":"messages","value":"[\n    {\n      \"role\": \"system\",\n      \"content\": \"Summarize the following passage, which describes a conspiracy belief, in a single sentence. Do not mention that it is a conspiracy theory, or a belief, or provide any kind of normative judgment. Merely accurately describe the content of the conspiracy theory in a single sentence, framing it in a manner that suggests the conspiracy is TRUE. So, even if the writing is arguing that the earth is not flat, you would say 'the earth is flat'). Frame it as a true assertion (regardless of whether evidence actually supports the belief). If the statement is already short, no need to change it very much. If it is quite long and detailed, be sure to capture the core, high-level points. If the respondent equivocates or couches their language in uncertainty, be sure not to include this equivocation in your summary. Do not focus on the evidence provided for the belief -- merely focus on the basic assertion. That is, use the evidence and justifications they might provide only for context. For your information, the passage was written by a participant in an online academic survey in response to the following two questions: < Q1: ${q:\/\/QID64\/QuestionText} > < ${q:\/\/QID166\/QuestionText} > Again, your role is to summarize the overarching belief captured by this response. Your summary will be shown to the participant, who will be asked to rate their agreement with the statement; their belief in the summary will be used as a psychometrics-style item in a scientific experiment.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Question 1 Response: ${q:\/\/QID64\/ChoiceTextEntryValue}, Question 2 Response: ${q:\/\/QID166\/ChoiceTextEntryValue}\"\n    }\n  ]","parameterType":"JSON"},{"key":"max_tokens","value":"150","parameterType":"Number"}],"Body":{"model":"gpt-4o","messages":[{"role":"system","content":"Summarize the following passage, which describes a conspiracy belief, in a single sentence. Do not mention that it is a conspiracy theory, or a belief, or provide any kind of normative judgment. Merely accurately describe the content of the conspiracy theory in a single sentence, framing it in a manner that suggests the conspiracy is TRUE. So, even if the writing is arguing that the earth is not flat, you would say 'the earth is flat'). Frame it as a true assertion (regardless of whether evidence actually supports the belief). If the statement is already short, no need to change it very much. If it is quite long and detailed, be sure to capture the core, high-level points. If the respondent equivocates or couches their language in uncertainty, be sure not to include this equivocation in your summary. Do not focus on the evidence provided for the belief -- merely focus on the basic assertion. That is, use the evidence and justifications they might provide only for context. For your information, the passage was written by a participant in an online academic survey in response to the following two questions: < Q1: ${q:\/\/QID64\/QuestionText} > < ${q:\/\/QID166\/QuestionText} > Again, your role is to summarize the overarching belief captured by this response. Your summary will be shown to the participant, who will be asked to rate their agreement with the statement; their belief in the summary will be used as a psychometrics-style item in a scientific experiment."},{"role":"user","content":"Question 1 Response: ${q:\/\/QID64\/ChoiceTextEntryValue}, Question 2 Response: ${q:\/\/QID166\/ChoiceTextEntryValue}"}],"max_tokens":150},"ContentType":"application\/json","Headers":[{"key":"Authorization","value":"Bearer REDACTED_OPENAI_KEY_ROTATE_ME"}],"ResponseMap":[{"key":"choices.0.message.content","value":"conRestatement"}],"FireAndForget":false,"SchemaVersion":0,"StringifyValues":true},{"Type":"WebService","FlowID":"FL_35","URL":"https:\/\/api.openai.com\/v1\/chat\/completions","Method":"POST","RequestParams":[],"EditBodyParams":[{"key":"model","value":"gpt-4o"},{"key":"messages","value":"[\n    {\n      \"role\": \"system\",\n      \"content\": \"Describe the conspiracy being discussed in a sentence or two. Do not provide any kind of normative judgment. Merely accurately describe the conspiracy theory at hand (framing it in a way so that another reader would understand what the conspiracy theory claims and is about. Do not focus unduly the evidence provided for the belief -- mostly focus on the basic assertion. Try to ignore whether the person who authored the text you'll be reading supports or opposes the conspiracy. Your job is just to capture the conspiracy claim. So, if they oppose the truth of the conspiracy, that is fine, but still return a description of the conspiracy that they're claiming is not true. For your context, the text you will be reading was written by a participant in an online academic survey in response to the following two questions: < Q1: ${q:\/\/QID64\/QuestionText} > < ${q:\/\/QID166\/QuestionText} >\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Question 1 Response: ${q:\/\/QID64\/ChoiceTextEntryValue}, Question 2 Response: ${q:\/\/QID166\/ChoiceTextEntryValue}\"\n    }\n  ]","parameterType":"JSON"},{"key":"max_tokens","value":"150","parameterType":"Number"}],"Body":{"model":"gpt-4o","messages":[{"role":"system","content":"Describe the conspiracy being discussed in a sentence or two. Do not provide any kind of normative judgment. Merely accurately describe the conspiracy theory at hand (framing it in a way so that another reader would understand what the conspiracy theory claims and is about. Do not focus unduly the evidence provided for the belief -- mostly focus on the basic assertion. Try to ignore whether the person who authored the text you'll be reading supports or opposes the conspiracy. Your job is just to capture the conspiracy claim. So, if they oppose the truth of the conspiracy, that is fine, but still return a description of the conspiracy that they're claiming is not true. For your context, the text you will be reading was written by a participant in an online academic survey in response to the following two questions: < Q1: ${q:\/\/QID64\/QuestionText} > < ${q:\/\/QID166\/QuestionText} >"},{"role":"user","content":"Question 1 Response: ${q:\/\/QID64\/ChoiceTextEntryValue}, Question 2 Response: ${q:\/\/QID166\/ChoiceTextEntryValue}"}],"max_tokens":150},"ContentType":"application\/json","Headers":[{"key":"Authorization","value":"Bearer REDACTED_OPENAI_KEY_ROTATE_ME"}],"ResponseMap":[{"key":"choices.0.message.content","value":"conSummary"}],"FireAndForget":false,"SchemaVersion":0,"StringifyValues":true},{"Type":"WebService","FlowID":"FL_69","URL":"https:\/\/api.openai.com\/v1\/chat\/completions","Method":"POST","RequestParams":[],"EditBodyParams":[{"key":"model","value":"gpt-4o"},{"key":"messages","value":"[\n    {\n      \"role\": \"system\",\n      \"content\": \"Determine if the following written response to a question posed in an online survey collectively contain or reflect skepticism toward, or disavowal of, or rejection of, a particular conspiracy theory (or something quite like a conspiracy theory). That is, has the participant written about a conspiracy theory that they do not believe is true. For your context, the text was written in response to the following two questions: < Q1: ${q:\/\/QID64\/QuestionText} > < Q2: ${q:\/\/QID166\/QuestionText} > The participant's answers to these questions are piped in as the first user response of this chat. We want to make sure they have correctly responded to the questions. Please determine if the participant's answers to these questions are piped contain or reflect skepticism towards a conspiracy theory (or something quite like a conspiracy theory). Categorize this statement as either: 'skepticism', 'noskepticism', 'unclear'. ONLY respond with one of those three words AND NOTHING ELSE.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Question 1 Response: ${q:\/\/QID64\/ChoiceTextEntryValue}, Question 2 Response: ${q:\/\/QID166\/ChoiceTextEntryValue}\"    }\n  ]","parameterType":"JSON"},{"key":"max_tokens","value":"5","parameterType":"Number"}],"Body":{"model":"gpt-4o","messages":[{"role":"system","content":"Determine if the following written response to a question posed in an online survey collectively contain or reflect skepticism toward, or disavowal of, or rejection of, a particular conspiracy theory (or something quite like a conspiracy theory). That is, has the participant written about a conspiracy theory that they do not believe is true. For your context, the text was written in response to the following two questions: < Q1: ${q:\/\/QID64\/QuestionText} > < Q2: ${q:\/\/QID166\/QuestionText} > The participant's answers to these questions are piped in as the first user response of this chat. We want to make sure they have correctly responded to the questions. Please determine if the participant's answers to these questions are piped contain or reflect skepticism towards a conspiracy theory (or something quite like a conspiracy theory). Categorize this statement as either: 'skepticism', 'noskepticism', 'unclear'. ONLY respond with one of those three words AND NOTHING ELSE."},{"role":"user","content":"Question 1 Response: ${q:\/\/QID64\/ChoiceTextEntryValue}, Question 2 Response: ${q:\/\/QID166\/ChoiceTextEntryValue}"}],"max_tokens":5},"ContentType":"application\/json","Headers":[{"key":"Authorization","value":"Bearer REDACTED_OPENAI_KEY_ROTATE_ME"}],"ResponseMap":[{"key":"choices.0.message.content","value":"isBunk"}],"FireAndForget":false,"SchemaVersion":0,"StringifyValues":true},{"Type":"Branch","FlowID":"FL_97","Description":"New Branch","BranchLogic":{"0":{"0":{"LogicType":"EmbeddedField","LeftOperand":"isBunk","Operator":"EqualTo","RightOperand":"noskepticism","_HiddenExpression":false,"Type":"Expression","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"LeftOpDesc\">isBunk<\/span> <span class=\"OpDesc\">Is Equal to<\/span> <span class=\"RightOpDesc\"> noskepticism <\/span>"},"1":{"LogicType":"EmbeddedField","LeftOperand":"isBunk","Operator":"EqualTo","RightOperand":"unclear","_HiddenExpression":false,"Type":"Expression","Description":"<span class=\"ConjDesc\">Or<\/span> <span class=\"LeftOpDesc\">isBunk<\/span> <span class=\"OpDesc\">Is Equal to<\/span> <span class=\"RightOpDesc\"> unclear <\/span>","Conjuction":"Or"},"Type":"If"},"Type":"BooleanExpression"},"Flow":[{"Type":"WebService","FlowID":"FL_136","URL":"https:\/\/api.openai.com\/v1\/chat\/completions","Method":"POST","RequestParams":[],"EditBodyParams":[{"key":"model","value":"gpt-4o"},{"key":"messages","value":"[\n    {\n      \"role\": \"system\",\n      \"content\": \"You are embedded in an academic survey environment (like Qualtrics). We've requested that the participant name a conspiracy theory that they DO NOT believe in and then asked them to explain their rationale for this disbelief. For your context, the two questions we posed were as follows: < Q1: ${q:\/\/QID64\/QuestionText} > < Q2: ${q:\/\/QID166\/QuestionText} > The participant's answers to these questions are <Q1 Response: ${q:\/\/QID64\/ChoiceTextEntryValue}> and < Q2 Response: ${q:\/\/QID166\/ChoiceTextEntryValue}>. Another LLM has determined that the participant failed to write about a conspiracy theory that they do not believe in (or that the participant otherwise failed to properly answer the question). Please provide feedback to the participant so that they can properly answer the question when we ask it again. Keep it short and sweet. Basically, just reaffirm that they're job is to write about a conspiracy theory that they do not believe in and then provide evidence for why. End your message by telling them they have a chance to try again.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Question 1 Response: ${q:\/\/QID64\/ChoiceTextEntryValue}, Question 2 Response: ${q:\/\/QID166\/ChoiceTextEntryValue}\"    }\n  ]","parameterType":"JSON"},{"key":"max_tokens","value":"1500","parameterType":"Number"}],"Body":{"model":"gpt-4o","messages":[{"role":"system","content":"You are embedded in an academic survey environment (like Qualtrics). We've requested that the participant name a conspiracy theory that they DO NOT believe in and then asked them to explain their rationale for this disbelief. For your context, the two questions we posed were as follows: < Q1: ${q:\/\/QID64\/QuestionText} > < Q2: ${q:\/\/QID166\/QuestionText} > The participant's answers to these questions are <Q1 Response: ${q:\/\/QID64\/ChoiceTextEntryValue}> and < Q2 Response: ${q:\/\/QID166\/ChoiceTextEntryValue}>. Another LLM has determined that the participant failed to write about a conspiracy theory that they do not believe in (or that the participant otherwise failed to properly answer the question). Please provide feedback to the participant so that they can properly answer the question when we ask it again. Keep it short and sweet. Basically, just reaffirm that they're job is to write about a conspiracy theory that they do not believe in and then provide evidence for why. End your message by telling them they have a chance to try again."},{"role":"user","content":"Question 1 Response: ${q:\/\/QID64\/ChoiceTextEntryValue}, Question 2 Response: ${q:\/\/QID166\/ChoiceTextEntryValue}"}],"max_tokens":1500},"ContentType":"application\/json","Headers":[{"key":"Authorization","value":"Bearer REDACTED_OPENAI_KEY_ROTATE_ME"}],"ResponseMap":[{"key":"choices.0.message.content","value":"feedbacktxt"}],"FireAndForget":false,"SchemaVersion":0,"StringifyValues":true},{"Type":"Standard","ID":"BL_e3Acbj1u9thoHR4","FlowID":"FL_137","Autofill":[]},{"Type":"EmbeddedData","FlowID":"FL_104","EmbeddedData":[{"Description":"feedback","Type":"Custom","Field":"feedback","VariableType":"String","DataVisibility":[],"AnalyzeText":false,"Value":"true"},{"Description":"originalIsBunk","Type":"Custom","Field":"originalIsBunk","VariableType":"String","DataVisibility":[],"AnalyzeText":false,"Value":"${e:\/\/Field\/isBunk}"},{"Description":"originalRestatement","Type":"Custom","Field":"originalRestatement","VariableType":"String","DataVisibility":[],"AnalyzeText":false,"Value":"${e:\/\/Field\/conRestatement}"},{"Description":"originalq1","Type":"Custom","Field":"originalq1","VariableType":"String","DataVisibility":[],"AnalyzeText":false,"Value":"${q:\/\/QID64\/ChoiceTextEntryValue}"},{"Description":"originalq2","Type":"Custom","Field":"originalq2","VariableType":"String","DataVisibility":[],"AnalyzeText":false,"Value":"${q:\/\/QID166\/ChoiceTextEnt